# Cache policy snippet — applied via `import cache_policy` in each site block.
# Build outputs (content-hashed by Vite/Next/Nuxt/CRA) get year-long immutable cache.
# Everything else (HTML, SPA routes, /boot, /healthz) is never cached at edge or browser
# so deploys take effect immediately. `defer` makes these headers win over upstream.
(cache_policy) {
	@build_assets path /assets/* /_next/static/* /_nuxt/* /static/js/* /static/css/* /static/media/*
	header @build_assets {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	@uncached not path /assets/* /_next/static/* /_nuxt/* /static/js/* /static/css/* /static/media/*
	header @uncached {
		Cache-Control "no-store, must-revalidate"
		CDN-Cache-Control "no-store"
		defer
	}
}

