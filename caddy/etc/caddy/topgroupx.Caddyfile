t3s.es, www.t3s.es {
	tls /etc/caddy/certs/t3s.es.pem /etc/caddy/certs/t3s.es.key

	@www host www.t3s.es
	redir @www https://t3s.es{uri} permanent

	respond /healthz "Status: 200. Working OVER: {http.request.proto}..." 200

	handle_path /sitemap.xml {
		rewrite * /api/internal/website/public/sitemap.xml
		reverse_proxy 100.112.35.16:8000 {
			header_up X-T3-SITEID "web"

			header_up Host {http.request.host}
		}
	}

	handle_path /robots.txt {
		rewrite * /api/internal/website/public/robots.txt
		reverse_proxy 100.112.35.16:8000 {
			header_up X-T3-SITEID "web"

			header_up Host {http.request.host}
		}
	}

	handle_path /llms.txt {
		rewrite * /api/internal/website/public/llms.txt
		reverse_proxy 100.112.35.16:8000 {
			header_up X-T3-SITEID "web"

			header_up Host {http.request.host}
		}
	}

	handle {
	    reverse_proxy 100.112.35.16:8104
	}

	encode gzip zstd
	log
}

