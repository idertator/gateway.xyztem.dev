# <- Backends ->

backend.t3s.es {
	tls /etc/caddy/certs/t3s.es.pem /etc/caddy/certs/t3s.es.key

	respond /healthz "Status: 200. Working OVER: {http.request.proto}..." 200

	reverse_proxy /* 100.112.35.16:8000

	encode gzip zstd

	log
}


# <- Clients ->

admin.t3s.es {
	tls /etc/caddy/certs/t3s.es.pem /etc/caddy/certs/t3s.es.key

	respond /healthz "Status: 200. Working OVER: {http.request.proto}..." 200

	header APP_ID: 1

	reverse_proxy /* 100.112.35.16:8080

	import cache_policy

	encode gzip zstd

	log
}


agencies.t3s.es {
	tls /etc/caddy/certs/t3s.es.pem /etc/caddy/certs/t3s.es.key

	respond /healthz "Status: 200. Working OVER: {http.request.proto}..." 200
	respond /boot "01,devel" 200

	@favicon path /favicon.ico /icon.png
	handle @favicon {
		root * /usr/share/caddy/b2b/tge
		file_server
	}

	@topbar path /topbar.png
	handle @topbar {
		root * /usr/share/caddy/b2b/tge
		file_server
	}

	reverse_proxy /* 100.112.35.16:8081

	import cache_policy

	encode gzip zstd

	log
}

b2c.t3s.es {
	tls /etc/caddy/certs/t3s.es.pem /etc/caddy/certs/t3s.es.key

	respond /healthz "Status: 200. Working OVER: {http.request.proto}..." 200

	handle_path /sitemap.xml {
		rewrite * /api/internal/intranets/b2c/cms/sitemap.xml
		reverse_proxy t3-backend-devel-server:8000 {
			header_up X-T3-APPID "33"
			header_up X-T3-SITEID "b2c"

			header_up Host {http.request.host}
		}
	}

	handle_path /robots.txt {
		rewrite * /api/internal/intranets/b2c/cms/robots.txt
		reverse_proxy t3-backend-devel-server:8000 {
			header_up X-T3-APPID "33"
			header_up X-T3-SITEID "b2c"

			header_up Host {http.request.host}
		}
	}

	handle_path /llms.txt {
		rewrite * /api/internal/intranets/b2c/cms/llms.txt
		reverse_proxy t3-backend-devel-server:8000 {
			header_up X-T3-APPID "33"
			header_up X-T3-SITEID "b2c"

			header_up Host {http.request.host}
		}
	}

	reverse_proxy /* 100.112.35.16:8082

	import cache_policy

	encode gzip zstd
	log
}


